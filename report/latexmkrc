# Build bằng XeLaTeX; file trung gian và PDF nằm trong build/
# Cờ -pdf (VS Code / LaTeX Workshop) ép latexmk gọi $pdflatex, nên trỏ
# $pdflatex sang xelatex để luôn dùng đúng engine dù bị gọi kiểu nào.
$pdf_mode = 1;
$pdflatex = 'xelatex -synctex=1 -interaction=nonstopmode -file-line-error %O %S';
$out_dir = 'build';
# Luôn build vào build/: bỏ -outdir/-auxdir trên dòng lệnh (recipe mặc định của LaTeX Workshop
# truyền -outdir=<thư mục main.tex> khi VS Code không đọc được .vscode/settings.json).
@ARGV = grep { !/^--?(?:out|aux)(?:dir|-directory)=/ } @ARGV;
$bibtex_use = 1.5;

# Thư mục có hai tài liệu: main.tex (báo cáo) và proposal.tex. Gọi `latexmk` không kèm tên file
# chỉ build báo cáo; proposal build bằng `latexmk proposal.tex` (cả hai dùng chung build/).
@default_files = ('main.tex');

# --- Tên file PDF ---------------------------------------------------------------
# PDF luôn được build ra build/<tài liệu>.pdf (giữ tên gốc để VS Code / SyncTeX hoạt động).
# Sau mỗi lần chạy latexmk, bản PDF mới được chép thành "<tên>.pdf" cạnh file .tex, với <tên> lấy từ
# \TenFilePDF (main) hoặc \TenFilePDFProposal (proposal) trong config/metadata.tex. Để trống thì không chép.
END {
  my %lenh = (main => 'TenFilePDF', proposal => 'TenFilePDFProposal');
  my $metadata = '';
  if (open(my $fh, '<', 'config/metadata.tex')) {
    local $/;
    $metadata = <$fh>;
    close $fh;
  }
  for my $tai_lieu (sort keys %lenh) {
    my $src = ($out_dir || '.') . "/$tai_lieu.pdf";
    my ($ten) = $metadata =~ /^\s*\\newcommand\{\\$lenh{$tai_lieu}\}\{([^}]*)\}/m;
    $ten //= '';
    $ten =~ s/^\s+|\s+$//g;
    $ten =~ s{[/\\:*?"<>|]}{-}g;                 # bỏ ký tự cấm trong tên file
    next unless $ten ne '' && -f $src;
    my $dst = "$ten.pdf";
    if (!-f $dst || -M $src < -M $dst) {         # chỉ chép khi PDF mới hơn
      require File::Copy; require Encode;
      my $hien = Encode::decode('UTF-8', $dst);  # đầu ra của latexmk đã mã hoá UTF-8
      File::Copy::copy($src, $dst)
        ? print "Latexmk: đã chép PDF thành '$hien'\n"
        : warn "Latexmk: không chép được PDF thành '$hien': $!\n";
    }
  }
}
